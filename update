#!/usr/bin/env bash
# One-command updater for this Caelestia fork.
# Syncs with the fork remote, rebuilds the native plugin only
# when it actually changed, reinstalls it AS A PACMAN PACKAGE, and restarts the
# shell.
#
# Safe to run anytime: if nothing changed it is a no-op (no sudo prompt, no
# shell restart). See CUSTOMIZATIONS.md / UPDATE_GUIDE.md for the manual steps
# this automates.
#
#   ./update                sync fork, rebuild if needed, restart, verify
#   ./update --status       read-only: what is running vs HEAD vs upstream
#   ./update --force-build  rebuild + reinstall even if nothing looks changed
#   ./update --port         rebase custom commits onto the latest upstream tag
#   ./update --prune-cache  prune the image cache only (no build, no restart)
#
# Nothing here runs on a schedule, on purpose: this script wants sudo and
# restarts the shell, neither of which belongs in an unattended timer. What IS
# automated is the REMINDER — ./update installs and enables
# caelestia-update-check.timer, which notifies when a plain ./update or a
# --port is due and applies nothing. See system/bin/caelestia-update-check.
#
# Prefer this over the manual cmake in UPDATE_GUIDE.md — and note that path is
# now WRONG, not merely inconvenient: since 2026-09-09 the plugin is installed
# as a pacman package (packaging/PKGBUILD), so a hand-run `sudo cmake --install`
# would go back to writing files pacman believes it owns. That is the exact
# fault this repo just spent a migration removing. `makepkg -si` from
# packaging/ is the manual equivalent now.
#
# Every path that restarts the shell also prunes the image cache first — see
# prune_image_cache() for why that is a correctness concern, not tidiness.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$REPO"

# THE BUILD FLAGS LIVE IN packaging/PKGBUILD NOW (ENABLE_MODULES, the install
# prefix, the accelerators). Do not reintroduce them here: two copies of that
# list is precisely how a module goes missing, and CMake accepts unknown entries
# in ENABLE_MODULES in SILENCE, so the drift is invisible until something fails
# at runtime.
#
# Still true and still worth knowing: "m3shapes" is DELIBERATELY not in that
# list. Upstream v2.4.0 (#1909 "build: split out m3shapes") moved M3Shapes into
# its own project, github.com/soramanew/m3shapes, packaged on Arch as
# qt6-m3shapes-git. Nothing under this repo builds it — CMakeLists.txt has no
# "m3shapes" branch at all — but our QML still `import M3Shapes` in a dozen
# files (including the forked Workspace.qml), so it is REQUIRED at runtime and
# is simply somebody else's to install. The PKGBUILD now declares it as a
# dependency, which is what finally makes that automatic; section 2 still warns
# if it is somehow absent.

step() { printf '\033[1;34m→\033[0m %s\n' "$*"; }
die()  { printf '\033[1;31m✗\033[0m %s\n' "$*" >&2; exit 1; }

# A port rewrites branch history, so the post-port push must be forced. Always
# use --force-with-lease, never --force: it aborts if origin moved since our
# last fetch (e.g. a push from another machine — see the multi-machine
# workflow), so we can never silently clobber work from the other box.
force_push_hint() {
    printf '  ⓘ Use --force-with-lease (not --force): it refuses to overwrite origin if another\n'
    printf '    machine pushed since your last fetch, so a rewritten branch never clobbers it.\n'
}

# Revision of the build that is CURRENTLY INSTALLED system-wide.
# /usr/lib/caelestia/version is a tiny binary with the source revision baked in
# at compile time (CMakeLists passes GIT_REVISION from `git rev-parse HEAD`), so
# it reports what actually got installed — our build or the distro package's.
# Line 3 of --terse is the revision. Returns non-zero if nothing is installed.
installed_rev() {
    [ -x /usr/lib/caelestia/version ] || return 1
    /usr/lib/caelestia/version --terse 2>/dev/null | sed -n 3p
}

# --- Image cache prune -----------------------------------------------------
# The shell's image cache (CachingImage -> CachingImageProvider -> ImageCacher)
# has NO eviction of its own: every distinct (source, size, fillMode) triple
# becomes a PNG under ~/.cache/caelestia/imagecache and nothing ever deletes it.
# It reached 2.0GB / 1779 files here, including 104 entries above 4096px -- up
# to 12288x8052, a 56MB PNG costing ~1.5s and ~340MB of RAM merely to READ back.
# Producing one measured 34.5s of pegged CPU. Those entries are what made the
# launcher and every flyout stall for tens of seconds, so this prune is part of
# the fix, not housekeeping. CachingImage.maxPixelSize now stops NEW ones being
# minted; this removes any that a pre-clamp shell (or a future regression) left.
#
# POLICY NOTE: ~/.cache is btrfs mounted noatime here, so there is no usable
# access time and a real LRU is impossible. Cache files are written once and
# never rewritten, so mtime is CREATION time -- the age rule below means "drop
# what was created long ago", NOT "drop what has not been used lately". A hot
# entry that ages out is simply re-rendered on next use, which is cheap and
# safe: everything in this directory is derived data with a source of truth
# elsewhere.
CACHE_MAX_DIM=${CACHE_MAX_DIM:-4096}        # keep in sync with CachingImage.maxPixelSize
CACHE_MAX_AGE_DAYS=${CACHE_MAX_AGE_DAYS:-30}
CACHE_MAX_MB=${CACHE_MAX_MB:-512}

prune_image_cache() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/caelestia/imagecache"

    # This function deletes files recursively, so bound it before it runs. The
    # suffix check alone is not a real guard (the path is built by appending that
    # literal, so it always matches) -- the load-bearing half is requiring the
    # directory to resolve inside $HOME, which stops a rogue XDG_CACHE_HOME from
    # aiming the delete at a system path. Both must hold.
    case "$cache" in
        */caelestia/imagecache) ;;
        *) die "Refusing to prune unexpected path '$cache'." ;;
    esac
    [ -d "$cache" ] || return 0
    local resolved
    resolved="$(cd "$cache" && pwd -P)" || die "Cannot resolve '$cache'."
    case "$resolved/" in
        "$HOME"/*) ;;
        *) die "Refusing to prune '$resolved' — outside \$HOME." ;;
    esac

    local before_kb before_n after_kb cur_kb cap_kb
    before_kb=$(du -sk "$cache" | cut -f1)
    before_n=$(find "$cache" -type f -name '*.png' | wc -l)

    # 1. Oversized entries. The filename encodes the request as
    #    <sha256>@<W>x<H>-<fillmode>.png, so the requested dimensions are readable
    #    without decoding anything. Only top-level entries carry that form; the
    #    notifs/ subdir uses plain hashes and is handled by rules 2 and 3.
    local oversized=0 f
    local victims
    victims=$(find "$cache" -maxdepth 1 -type f -name '*@*x*-*.png' -printf '%f\n' 2>/dev/null | awk -v max="$CACHE_MAX_DIM" -v dir="$cache" '
        { n = $0
          sub(/^.*@/, "", n)
          sub(/-[^-]*\.png$/, "", n)
          split(n, d, "x")
          if (d[1] + 0 > max || d[2] + 0 > max) print dir "/" $0 }')
    if [ -n "$victims" ]; then
        while IFS= read -r f; do
            [ -n "$f" ] || continue
            # `rm && count` would abort the whole script under `set -e` if a file
            # vanished between the find and the rm; count only what actually went.
            if rm -f -- "$f"; then
                oversized=$((oversized + 1))
            fi
        done <<< "$victims"
    fi

    # 2. Aged-out entries (creation-time semantics -- see the policy note above).
    local aged
    aged=$(find "$cache" -type f -name '*.png' -mtime +"$CACHE_MAX_AGE_DAYS" -print -delete 2>/dev/null | wc -l)

    # 3. Hard size cap, oldest first. Runs last so it only handles whatever the
    #    two cheaper rules left behind.
    local capped=0 line sz path
    cap_kb=$((CACHE_MAX_MB * 1024))
    cur_kb=$(du -sk "$cache" | cut -f1)
    if [ "$cur_kb" -gt "$cap_kb" ]; then
        while IFS= read -r line; do
            [ "$cur_kb" -gt "$cap_kb" ] || break
            sz="${line%% *}"
            path="${line#* }"
            rm -f -- "$path" || continue
            cur_kb=$(( cur_kb - (sz + 1023) / 1024 ))
            capped=$((capped + 1))
        done < <(find "$cache" -type f -name '*.png' -printf '%T@ %s %p\n' 2>/dev/null | sort -n | cut -d' ' -f2-)
    fi

    after_kb=$(du -sk "$cache" | cut -f1)
    step "pruned image cache: ${oversized} oversized (>${CACHE_MAX_DIM}px), ${aged} aged (>${CACHE_MAX_AGE_DAYS}d), ${capped} over ${CACHE_MAX_MB}MB cap"
    printf '  %sMB / %s files -> %sMB / %s files\n' \
        "$((before_kb / 1024))" "$before_n" "$((after_kb / 1024))" "$(find "$cache" -type f -name '*.png' | wc -l)"
}

# Optional build accelerators, used only when installed. Both are PURE SPEED —
# neither changes a byte of observable behaviour in the output — so a machine
# without them still builds a correct plugin, just slower. That matters for the
# multi-machine setup: this must never become a hard prerequisite.
#
# This box is 4 cores / 8 GB, so the two costs worth attacking are recompiling
# TUs that did not change and linking ~20 shared objects:
#
#   ccache  Ninja already gives incrementality WITHIN a build tree, but the
#           expensive cases are exactly the ones that defeat it — `--force-build`
#           after a soname bump, a --port rebase, switching branches. Those
#           recompile ~200 TUs that are usually byte-identical to ones built
#           minutes earlier. Needs system/ccache/ccache.conf to be useful at
#           all; see the sloppiness comment there.
#   mold    ~3-5x faster than GNU ld here and much better at using 4 cores.
#           lld is the fallback and is already present via llvm.
#
# The detection itself now lives in packaging/PKGBUILD's build(), because that
# is where the cmake invocation moved. It is the same probe (ccache launcher if
# present, mold else lld for CMAKE_LINKER_TYPE, which needs cmake >= 3.29), kept
# there rather than passed in from here so that a plain `makepkg -si` run by
# hand is exactly as fast as one driven by this script.
#
# Note makepkg.conf on this box has BUILDENV=(!ccache), so the PKGBUILD has to
# pass the launcher explicitly — enabling it there would be a system-wide change
# for one package's benefit.

# Build + install the native plugin AS A PACKAGE. Shared by the normal update
# path and by a port (which always needs a rebuild because the base moved).
#
# *** WHY THIS IS NOT `sudo cmake --install` ANY MORE (changed 2026-09-09). ***
# It used to be, with CMAKE_INSTALL_PREFIX=/ — which wrote straight into paths
# owned by the AUR package caelestia-shell. pacman never knew. Measured on
# 2026-09-09: `pacman -Qkk caelestia-shell` reported "411 total files, 37
# altered files", the package dated 2026-08-12 and the files on disk dated
# 2026-09-06. Two owners for one set of files and only one of them keeping
# records, so every -Syu that touched caelestia-shell silently reverted 37 files
# to stock and left fork QML running against stock binaries until someone
# noticed. Going through makepkg makes pacman the single owner, which is what
# turns `pacman -Qkk` back into a real integrity check and makes a package
# upgrade incapable of clobbering this build.
#
# TWO THINGS DELETED THEMSELVES WITH THAT CHANGE, do not put them back:
#   - the ENABLE_MODULES/INSTALL_QSCONFDIR flags (see the note at the top);
#   - the root-owned shell.qml restore. INSTALL_QSCONFDIR used to point at this
#     repo, so the install re-emitted shell.qml onto its own source as a
#     root-owned, watchFiles:false copy and it had to be `git checkout`-ed back.
#     The package does not ship the QML at all (packaging/PKGBUILD explains
#     why), so nothing writes into the working tree any longer.
#
# NOT WRAPPED IN sudo: makepkg refuses to run as root and escalates on its own
# for the final `pacman -U`. Wrapping it here would break it outright.
build_install() {
    # Take the sudo credential BEFORE the build, not after it. makepkg escalates
    # on its own for the final `pacman -U`, so if that prompt cannot be answered
    # — no TTY, or an expired timestamp in a non-interactive run — the failure
    # lands AFTER a full compile, leaving a built package on disk and nothing
    # installed (observed 2026-09-09). `sudo -v` moves the ask to the top and is
    # free when the timestamp is already valid.
    sudo -v || die "sudo is required: makepkg installs the package with pacman -U"
    step "building package (makepkg)"
    # -f: needed_build can be true while the commit is unchanged (an ABI drift
    #     rebuild from section 2.5/2.6), and pkgver() would then produce a
    #     version makepkg already has a tarball for and would refuse to rebuild.
    # -s: pulls missing repo deps. An AUR-only one (qt6-m3shapes-git, the ttf-*
    #     fonts) is not resolvable this way and fails naming the package, which
    #     is the right loud failure.
    # --noconfirm answers makepkg's own prompts; pacman still hard-errors on a
    #     file conflict rather than overwriting, which is the behaviour we want.
    ( cd "$REPO/packaging" && makepkg -sif --noconfirm ) \
        || die "makepkg failed — see packaging/PKGBUILD"
}

# Restart the shell THROUGH SYSTEMD when the user unit exists, because that unit
# owns the shell's lifecycle (caelestia.service is WantedBy=graphical-session.target,
# so login starts it). Driving the restart through the CLI instead is wrong twice:
#
#   1. It leaves the shell dead. `caelestia shell -k` makes the unit exit
#      0/SUCCESS, and the unit is Restart=on-failure — so systemd deliberately
#      does NOT bring it back. The follow-up `caelestia shell -d &` is a
#      background child of this script, so when ./update exits (notably when run
#      from a short-lived non-interactive shell) it is reaped before it takes
#      over and nothing comes up. Hit on 2026-08-15 right after the v2.3.0
#      install: install succeeded, bar never returned.
#   2. When that spawn DOES survive, it runs the shell outside the unit, so the
#      service reads inactive and verify_shell's `journalctl -u caelestia.service`
#      window sees no output at all — reporting a cheerful false "came up clean".
#
# The CLI path is kept for machines that run the shell without the unit.
#
# The CLI path is also outside the unit's cgroup, so a shell started that way
# loses whatever Environment= the unit sets.
restart_shell() {
    step "restarting shell"
    # Anchor for verify_shell: without it a "--since 1 min ago" window would also
    # scoop up errors logged BEFORE this restart (e.g. the crash you are fixing)
    # and report the new shell as broken when it came up fine.
    RESTART_TS="$(date '+%Y-%m-%d %H:%M:%S')"
    # `systemctl cat` is the existence check: it fails when no such unit is known,
    # unlike is-enabled/is-active which also fail for a present-but-stopped unit.
    if systemctl --user cat caelestia.service >/dev/null 2>&1; then
        systemctl --user restart caelestia.service \
            || die "systemctl --user restart caelestia.service failed — check 'systemctl --user status caelestia.service'."
    else
        caelestia shell -k >/dev/null 2>&1 || true
        caelestia shell -d >/dev/null 2>&1 &
    fi
}

# Confirm the shell actually came up clean. A mismatched QML/plugin pairing does
# NOT stop the shell from starting — it degrades (dead bar, dead launcher, "??"
# keyboard layout) while ./update prints a cheerful green tick, so the breakage
# surfaces minutes later with no obvious cause. Advisory only: it must never fail
# the update, because a false positive here would be worse than a missed warning.
verify_shell() {
    command -v journalctl >/dev/null 2>&1 || return 0
    step "verifying shell came up clean"
    sleep 4
    # Is it even RUNNING? The log grep below cannot tell "no errors" from "no
    # shell": a dead unit logs nothing and reads as clean. Check liveness first,
    # and say so loudly — a missing bar with a green tick is the worst outcome
    # this script can produce (2026-08-15).
    if systemctl --user cat caelestia.service >/dev/null 2>&1 \
       && ! systemctl --user is-active --quiet caelestia.service; then
        printf '\033[1;31m✗\033[0m Shell is NOT running (caelestia.service inactive after restart).\n' >&2
        printf '    systemctl --user start caelestia.service\n' >&2
        printf '    systemctl --user status caelestia.service   # if it will not stay up\n' >&2
        return 0
    fi
    errs="$(journalctl --user -u caelestia.service --since "${RESTART_TS:-1 min ago}" --no-pager 2>/dev/null \
        | grep -iE 'is not a type|is not defined|unavailable|ReferenceError|TypeError' \
        | tail -5 || true)"
    if [ -n "$errs" ]; then
        printf '\033[1;33m!\033[0m Shell restarted but the journal shows QML errors:\n' >&2
        printf '%s\n' "$errs" | sed 's/^/    /' >&2
        printf '  Usually a QML/plugin mismatch — try `./update --force-build`. If it started\n' >&2
        printf '  right after a port, see the "upstream deleted a component" note in UPDATE_GUIDE.md.\n' >&2
    else
        printf '\033[1;32m✓\033[0m Shell came up clean.\n'
    fi
}

# Files under system/ that belong OUTSIDE the repo. They are the Qt-drift early
# warning system (see section 2.5), and vendoring them here is the only reason
# the other machine gets them at all — a git clone carries no /etc content, so
# before this they had to be reinstalled by hand per box and silently drifted.
#
# Format: repo path | destination | mode. A destination under $HOME installs
# without sudo; anything else needs root.
SYSTEM_FILES=(
    "system/pacman/90-quickshell-qt-drift.hook|/etc/pacman.d/hooks/90-quickshell-qt-drift.hook|644"
    "system/pacman/quickshell-qt-drift|/usr/share/libalpm/scripts/quickshell-qt-drift|755"
    "system/systemd/caelestia.service|$HOME/.config/systemd/user/caelestia.service|644"
    "system/ccache/ccache.conf|$HOME/.config/ccache/ccache.conf|644"
    "system/bin/caelestia-update-check|$HOME/.local/bin/caelestia-update-check|755"
    "system/systemd/caelestia-update-check.service|$HOME/.config/systemd/user/caelestia-update-check.service|644"
    "system/systemd/caelestia-update-check.timer|$HOME/.config/systemd/user/caelestia-update-check.timer|644"
)

# Timers that must be running for a vendored unit to do anything. Installing a
# .timer file only puts it on disk — nothing starts until it is enabled, so
# without this the update check would ship to the other machine as an inert
# file and never fire there. Kept separate from SYSTEM_FILES because enabling
# is idempotent-but-not-free: it is checked every run, not just on drift, since
# a `systemctl --user disable` leaves the file identical and cmp sees nothing.
ENABLE_TIMERS=(
    "caelestia-update-check.timer"
)

# Install any vendored system file that is missing or out of date.
#
# Must stay a no-op when everything matches: ./update promises "run it anytime,
# nothing changed means no sudo prompt", and a script that prompts for a
# password on every no-op run is a script you stop running. So compare first
# with cmp and only shell out to sudo for files that actually differ.
#
# $1 = "check" to only report drift (used by --status; never prompts).
sync_system_files() {
    mode="${1:-install}"
    drifted=0
    reload_systemd=false
    for entry in "${SYSTEM_FILES[@]}"; do
        IFS='|' read -r src dest perm <<<"$entry"
        [ -f "$REPO/$src" ] || continue
        cmp -s "$REPO/$src" "$dest" && continue
        drifted=$((drifted + 1))
        if [ "$mode" = check ]; then
            printf 'system file    : %s \033[1;33m(differs from %s)\033[0m\n' "$dest" "$src"
            continue
        fi
        step "installing $dest"
        case "$dest" in
            "$HOME"/*)
                install -Dm"$perm" "$REPO/$src" "$dest" \
                    || die "failed to install $dest"
                case "$dest" in */systemd/user/*) reload_systemd=true ;; esac
                ;;
            *)
                sudo install -Dm"$perm" "$REPO/$src" "$dest" \
                    || die "failed to install $dest (needs sudo)"
                ;;
        esac
    done
    if [ "$mode" = check ]; then
        [ "$drifted" -eq 0 ] && printf 'system files   : %s \033[1;32m(in sync)\033[0m\n' "${#SYSTEM_FILES[@]}"
        for t in "${ENABLE_TIMERS[@]}"; do
            systemctl --user is-enabled --quiet "$t" 2>/dev/null \
                || printf 'timer          : %s \033[1;33m(not enabled)\033[0m\n' "$t"
        done
        return 0
    fi
    if [ "$reload_systemd" = true ]; then
        # Picks up unit changes (e.g. the StartLimit* cap) without touching the
        # running shell; the restart in section 4 is what actually applies them.
        systemctl --user daemon-reload || true
    fi
    # Enable after the reload, so a timer being enabled for the FIRST time in
    # this same run refers to a unit systemd already knows about.
    #
    # `enable --now` rather than plain enable: without it a freshly installed
    # timer stays dormant until the next login, which is the one moment you
    # least want to discover the check was never running. Failure is advisory —
    # ./update must not die because a timer would not start.
    for t in "${ENABLE_TIMERS[@]}"; do
        systemctl --user is-enabled --quiet "$t" 2>/dev/null && continue
        step "enabling $t"
        systemctl --user enable --now "$t" \
            || printf '\033[1;33m!\033[0m Could not enable %s — the update check will not run.\n' "$t" >&2
    done
    return 0
}

pkgver() { pacman -Q "$1" 2>/dev/null | awk '{print $2}' || true; }

# One-shot answer to "what is actually running, and is anything due?". Replaces
# hand-poking git describe / pacman -Q / the version binary every time something
# looks off. Strictly read-only: no fetch, no build, no restart, no sudo.
status_report() {
    inst="$(installed_rev || true)"
    head_full="$(git rev-parse HEAD)"
    printf 'branch         : %s\n' "$(git rev-parse --abbrev-ref HEAD)"
    printf 'fork HEAD      : %s (%s)\n' "$(git rev-parse --short HEAD)" "$(git describe --tags 2>/dev/null || echo 'untagged')"
    if [ -z "$inst" ]; then
        printf 'installed build: \033[1;33mnone — run ./update\033[0m\n'
    elif [ "$inst" = "$head_full" ]; then
        printf 'installed build: %s \033[1;32m(matches HEAD)\033[0m\n' "${inst:0:8}"
    else
        printf 'installed build: %s \033[1;33m(STALE — run ./update)\033[0m\n' "${inst:0:8}"
    fi
    # caelestia-shell-fork is OURS (packaging/PKGBUILD); a dash here means the
    # plugin is not installed as a package and ./update has not run since the
    # migration. qt6-m3shapes-git is listed because it is a hard runtime import
    # this repo cannot build — a dash there is a shell that will not start.
    sv="$(pkgver caelestia-shell-fork)"; cv="$(pkgver caelestia-cli)"
    qv="$(pkgver quickshell-git)"; mv="$(pkgver qt6-m3shapes-git)"
    printf 'pacman pkgs    : caelestia-shell-fork %s / caelestia-cli %s\n' \
        "${sv:-—}" "${cv:-—}"
    printf '                 quickshell-git %s / qt6-m3shapes-git %s\n' \
        "${qv:-—}" "${mv:-—}"
    # Compare the NAME pacman resolves, not merely whether the query succeeds:
    # `pacman -Q caelestia-shell` follows Provides and happily answers
    # "caelestia-shell-fork", so an -n test on the version is true forever once
    # our own package is installed. Only a literal name match means the AUR
    # package is really back.
    if [ "$(pacman -Qq caelestia-shell 2>/dev/null)" = caelestia-shell ]; then
        printf '                 \033[1;33mcaelestia-shell (AUR) is installed — it conflicts with our package\033[0m\n'
    fi
    tag="$(git describe --tags --abbrev=0 upstream/main 2>/dev/null || true)"
    if [ -n "$tag" ]; then
        if git merge-base --is-ancestor "$tag" HEAD 2>/dev/null; then
            printf 'upstream       : %s \033[1;32m(based on it)\033[0m\n' "$tag"
        else
            printf 'upstream       : %s \033[1;33m(port due — ./update --port)\033[0m\n' "$tag"
        fi
    fi
    sync_system_files check
    printf 'working tree   : %s modified file(s)\n' "$(git status --porcelain | wc -l)"
}

# --- 0. Optional: port custom fork onto a newer upstream Caelestia ----------
# Triggered ONLY by `./update --port`; the default run never starts a rebase,
# preserving the "safe to run anytime" guarantee. This scripts the MECHANICAL
# scaffolding of a port — snapshot a backup branch, fetch upstream, start the
# rebase onto the latest upstream tag — and then gets out of the way. Conflict
# resolution stays manual on purpose: choosing which side wins in our forked
# components (workspace naming, 2.0 token-API ports, …) needs human judgment.
# On a clean rebase it reports success; on conflicts it halts with the exact
# commands to finish or bail, and the backup branch is always there to restore.
port_upstream() {
    branch="$(git rev-parse --abbrev-ref HEAD)"
    [ "$branch" != "HEAD" ] || die "Detached HEAD — checkout your branch first."
    git remote get-url upstream >/dev/null 2>&1 || die "No 'upstream' remote — add caelestia-dots/shell as 'upstream' first."

    # A rebase needs a clean tree; don't silently stash custom edits mid-port.
    git diff --quiet && git diff --cached --quiet || \
        die "Working tree not clean — commit or stash your changes before porting."

    step "fetch upstream (tags + main)"
    git fetch --quiet --tags upstream main || die "Could not fetch upstream."

    # Port onto the latest upstream RELEASE TAG (matches how fadcaf28 landed on
    # v2.0.3), not a moving branch tip — releases are the stable port targets.
    target="$(git describe --tags --abbrev=0 upstream/main 2>/dev/null || true)"
    [ -n "$target" ] || die "Could not determine latest upstream tag."

    base="$(git merge-base HEAD "$target")"
    if [ "$base" = "$(git rev-parse "$target^{commit}")" ]; then
        printf '\033[1;32m✓\033[0m Already based on %s — nothing to port.\n' "$target"
        exit 0
    fi

    backup="backup/${branch}-pre-${target}"
    if git rev-parse --verify --quiet "refs/heads/$backup" >/dev/null; then
        backup="${backup}-$(git rev-parse --short HEAD)"  # avoid clobbering an earlier attempt
    fi
    step "snapshot backup branch: $backup"
    git branch "$backup"

    step "rebasing $branch onto $target (custom commits replayed on top)"
    if ! git rebase "$target"; then
        printf '\033[1;33m!\033[0m Rebase hit conflicts — this is expected; resolve by hand:\n' >&2
        printf '    1. edit conflicted files, `git add` them\n' >&2
        printf '    2. `git rebase --continue`   (repeat until done)\n' >&2
        # NOT --port: once the rebase lands, merge-base HEAD == target, so --port
        # short-circuits on "Already based on ... nothing to port" and never
        # reaches build_install. --force-build is the correct finisher.
        printf '    3. `./update --force-build` to rebuild + restart, then force-push\n' >&2
        printf '  Bail out anytime with `git rebase --abort` — your branch is also saved at %s.\n' "$backup" >&2
        exit 1
    fi

    # The base moved, so native code almost certainly changed — rebuild and
    # restart right here so the running shell IS the ported version to test.
    # Doing it in-line avoids the trap where a follow-up plain `./update` would
    # `git pull --rebase` against the still-old origin and UNDO the port.
    build_install
    prune_image_cache
    restart_shell
    verify_shell
    printf '\033[1;32m✓\033[0m Ported onto %s, rebuilt, and restarted. Test the running shell; if good:\n' "$target"
    printf '      git push --force-with-lease origin %s\n' "$branch"
    force_push_hint
    printf '  Until you push, origin still has the OLD history — do NOT run plain ./update first\n' >&2
    printf '  (it would rebase the port away). The sync step now guards against this anyway.\n' >&2
    printf '  Backup of the pre-port branch: %s\n' "$backup"
    exit 0
}

case "${1:-}" in
    --port)   port_upstream ;;             # never returns
    --status) status_report; exit 0 ;;     # read-only, no network
    # Prune only. Useful after a shell that predates the sourceSize clamp has
    # already filled the cache with oversized entries, without forcing a rebuild.
    --prune-cache) prune_image_cache; exit 0 ;;
    # Rebuild + reinstall + restart exactly what is checked out, skipping the
    # sync entirely. Deliberately standalone: right after a --port the branch has
    # been rewritten, so local and origin have diverged and the sync guard below
    # refuses to run. Routing --force-build through it would mean you could not
    # rebuild to TEST a port until you had already force-pushed it — the exact
    # opposite of the "test, then push" order --port itself recommends.
    --force-build)
        # Sync system files here too. This path exits before section 2.4 ever
        # runs, so without this line the vendored pacman hook / ccache.conf are
        # installed ONLY by a plain `./update` — and --force-build is precisely
        # what you run when the shell is broken and a plain update is not an
        # option (2026-08-23: the libcava fix went in this way and left the old
        # Qt-only hook installed, so the next soname bump would have been just
        # as silent as the one being fixed).
        sync_system_files
        build_install
        prune_image_cache
        restart_shell
        verify_shell
        printf '\033[1;32m✓\033[0m Rebuilt and restarted (%s)\n' "$(git log --oneline -1)"
        exit 0
        ;;
    "")       ;;
    *)        die "Unknown argument '$1' (supported: --port, --status, --force-build)." ;;
esac

# --- 1. Sync ---------------------------------------------------------------
branch="$(git rev-parse --abbrev-ref HEAD)"
[ "$branch" != "HEAD" ] || die "Detached HEAD — checkout your branch first."
step "fetch + rebase origin/$branch (autostash local edits)"
old="$(git rev-parse HEAD)"

# Divergence guard: if local and origin have BOTH moved relative to each other
# (each has commits the other lacks), a `git pull --rebase` would replay our
# local commits onto origin's tip — which, right after a port, means rebasing
# the freshly-ported branch back onto the STALE pre-port origin and silently
# undoing the port (it happened: the rebase "skipped previously applied" the
# custom commits and reset us to the old base). Refuse instead of rewriting.
if git fetch --quiet origin "$branch" 2>/dev/null; then
    ahead="$(git rev-list --count "origin/$branch..HEAD" 2>/dev/null || echo 0)"
    behind="$(git rev-list --count "HEAD..origin/$branch" 2>/dev/null || echo 0)"
    if [ "$ahead" -gt 0 ] && [ "$behind" -gt 0 ]; then
        printf '\033[1;31m✗\033[0m Local and origin/%s have diverged (ahead %s / behind %s).\n' "$branch" "$ahead" "$behind" >&2
        printf '  If you just ran ./update --port, this is expected — push the port first:\n' >&2
        printf '      git push --force-with-lease origin %s\n' "$branch" >&2
        force_push_hint >&2
        printf '  Otherwise reconcile by hand. Refusing to auto-rebase so the port is not undone.\n' >&2
        exit 1
    fi
fi

if ! git pull --rebase --autostash; then
    die "Rebase hit a conflict. Resolve it, run 'git rebase --continue', then re-run ./update."
fi
new="$(git rev-parse HEAD)"

# --- 2. Decide whether a native rebuild is needed --------------------------
needs_build=false
if [ "$old" != "$new" ]; then
    if git diff --name-only "$old" "$new" | grep -qE '^(plugin/|extras/|CMakeLists\.txt)'; then
        needs_build=true
    fi
fi
# Also build if the plugin isn't installed yet (fresh machine / first run).
#
# This sentinel USED to test the M3Shapes plugin, which was the right file until
# v2.4.0 split M3Shapes out (see the MODULES comment). Testing it now would be a
# rebuild loop that cannot terminate: a missing M3Shapes would set needs_build,
# our build does not produce M3Shapes, so the next run would find it missing
# again. Test something this repo actually installs.
[ -f /usr/lib/qt6/qml/Caelestia/libcaelestia-coreplugin.so ] || needs_build=true

# M3Shapes is required at runtime (a dozen `import M3Shapes` in our QML) but is
# no longer ours to build, so a rebuild can never fix its absence — say so
# instead, with the command that does. Warn only; a shell that is currently
# running is proof enough that it must not block the update.
if [ ! -f /usr/lib/qt6/qml/M3Shapes/libm3shapesplugin.so ]; then
    printf '\033[1;33m!\033[0m M3Shapes is not installed, and this repo no longer builds it (upstream v2.4.0 split it out).\n' >&2
    printf '  Our QML imports it in a dozen places, so the shell will fail with "Type ... unavailable":\n' >&2
    printf '      paru -S qt6-m3shapes-git\n' >&2
fi

# Also rebuild when what is INSTALLED was not built from this checkout.
#
# This check was born as THE PACMAN CLOBBER detector: `pacman -Syu` (or
# `paru -S caelestia-shell`) used to reinstall the PACKAGED plugin over ours,
# silently reverting the fork's native code while our QML kept running against
# it. Symptoms were delayed and confusing — "Type X is not a type" after an
# upstream version bump, or an About page reporting the packaged version
# (2026-08-12: cost a full manual rebuild + diagnosis to spot).
#
# Since 2026-09-09 that specific route is CLOSED: we ship caelestia-shell-fork,
# which provides/conflicts caelestia-shell, so pacman refuses to install the AUR
# package over ours instead of quietly winning. The check stays anyway, because
# it is the only thing that catches the general case — a half-finished makepkg,
# an install done from another branch, a manual pacman -U of an older build.
# Comparing the baked-in revision is exact and costs one exec.
if [ "$needs_build" = false ]; then
    if inst_rev="$(installed_rev)"; then
        if [ "$inst_rev" != "$new" ]; then
            step "installed build is ${inst_rev:0:8}, HEAD is ${new:0:8} (package clobber or stale install) → rebuilding"
            needs_build=true
        fi
    else
        step "no installed version marker found → rebuilding"
        needs_build=true
    fi
fi

# --- 2.4 Install vendored system files -------------------------------------
# Runs before 2.5 so a fresh machine gets the pacman hook in the same pass that
# would otherwise be its first Qt-drift rebuild — the whole point is that the
# NEXT Qt update warns, and a hook installed one run too late misses it. No-op
# (and no sudo prompt) when the destinations already match, which is the normal
# case; see sync_system_files.
sync_system_files

# --- 2.5 Rebuild quickshell if Qt moved under it ---------------------------
# quickshell-git is an AUR package compiled against whatever Qt was installed at
# build time, and it resolves ~60 Qt_6_PRIVATE_API symbols spanning Qt6Core,
# Qt6Gui, Qt6Qml, Qt6Quick and Qt6WaylandClient. When pacman later updates Qt,
# the running binary keeps working but ANY restart dies at the dynamic linker
# ("undefined symbol: ..., version Qt_6_PRIVATE_API", exit 127) before a line of
# QML is parsed - and an uncapped systemd Restart= then spins on it.
#
# Ask the linker, don't guess from package mtimes. `ldd -r` resolves every
# relocation against the Qt installed right now, which is exactly the thing that
# fails at startup. The mtime heuristic this replaces was both too eager and too
# lax: a bare `pacman -S qt6-base` REINSTALL bumps the db entry and provokes a
# needless ~10min rebuild, while a Qt package rebuilt in the same transaction as
# quickshell can land in either order.
#
# This only fires when you RUN ./update. The pacman hook at
# /etc/pacman.d/hooks/90-quickshell-qt-drift.hook is what warns at upgrade time,
# while the shell is still running and the fix is still cheap; it uses the same
# ldd -r test. Note quickshell-git ships its own quickshell-check.hook, but that
# one runs the binary under test, so when the answer is "broken" it can only
# crash with a bare symbol-lookup error rather than tell you what to do.
QT_DRIFT_STAMP=/var/lib/quickshell-qt-drift
qs_rebuilt=false
qs_bin="$(command -v quickshell || true)"
qs_missing=""
if [ -n "$qs_bin" ]; then
    # `|| true` is load-bearing: grep exits 1 when it finds nothing, which is the
    # HEALTHY case here, and under `set -o pipefail` that status is the
    # pipeline's, so the assignment fails and `set -e` aborts ./update on the
    # spot -- after 2.4 has already run, with no message, exiting 1. That makes
    # a working quickshell look like a silent no-op update: the pacman hooks get
    # installed and the plugin never rebuilds (hit 2026-08-23).
    qs_missing="$(ldd -r "$qs_bin" 2>&1 | grep 'undefined symbol' | head -3 || true)"
fi
if [ -n "$qs_missing" ]; then
    if command -v yay >/dev/null 2>&1; then
        step "quickshell no longer links against the installed Qt → rebuilding quickshell-git (sudo + compile)"
        printf '%s\n' "$qs_missing" | sed 's/^/    /'
        if yay -S quickshell-git; then
            qs_rebuilt=true
            # Best-effort: ldd -r above is authoritative, so a stamp we fail to
            # remove only costs a redundant warning.
            sudo rm -f "$QT_DRIFT_STAMP" 2>/dev/null || true
        else
            die "quickshell rebuild failed — fix it, then re-run ./update (or 'yay -S quickshell-git')."
        fi
    else
        printf '\033[1;33m!\033[0m quickshell is broken against the installed Qt but yay was not found — rebuild it manually or the next restart dies.\n' >&2
    fi
fi

# --- 2.6 Rebuild the plugin if ITS libraries moved under it ----------------
# The same failure as 2.5, one layer down, and completely invisible to it: 2.5
# asks whether `qs` links, and it does. The native plugin is a separate build
# against libcava, aubio, qalculate, pipewire, libsensors and friends, so when
# one of THOSE bumps its soname, quickshell starts perfectly and then dies on
# the QML import with `Type ServiceLoader unavailable` / `Type Audio
# unavailable` — which reads like a QML bug, not an ABI break (2026-08-23:
# libcava 0.10.7 -> 1.0.0 left libcava.so.0 dangling; the shell burned its whole
# systemd start-limit at the next login and the message named Audio.qml, not
# libcava).
#
# Ask about the INSTALLED objects, not the build tree — those are what the shell
# actually dlopens. Setting needs_build is the entire fix: section 3
# reconfigures, and pkg_check_modules then resolves libcava against what is on
# disk now. One finding is enough to justify the rebuild, so stop at the first.
if [ "$needs_build" = false ]; then
    plugin_missing=""
    while IFS= read -r so; do
        # Same pipefail trap as 2.5 -- a cleanly-linking .so makes grep exit 1.
        found="$(ldd -r "$so" 2>&1 | grep -E 'not found|undefined symbol' | head -2 || true)"
        [ -n "$found" ] || continue
        plugin_missing="$so"$'\n'"$found"
        break
    # Only OUR objects: since v2.4.0 M3Shapes belongs to qt6-m3shapes-git, and a
    # rebuild here cannot relink somebody else's package. Including it would turn
    # "M3Shapes broke against the new Qt" into a rebuild that changes nothing and
    # then reports success — the exact silent-wrong-build shape this section
    # exists to expose. Its ABI drift is pacman's to fix (yay -S qt6-m3shapes-git).
    done < <(find /usr/lib/qt6/qml/Caelestia \
        -type f -name '*.so' 2>/dev/null | sort)
    if [ -n "$plugin_missing" ]; then
        step "installed plugin no longer links against its libraries → rebuilding"
        printf '%s\n' "$plugin_missing" | sed 's/^/    /'
        needs_build=true
    fi
fi

# --- 3. Build + install (only if needed) -----------------------------------
if [ "$needs_build" = true ]; then
    step "native inputs changed → rebuilding"
    build_install
else
    step "no native changes — skipping rebuild"
fi

# --- 4. Restart shell (only if anything changed) ---------------------------
if [ "$old" != "$new" ] || [ "$needs_build" = true ] || [ "$qs_rebuilt" = true ]; then
    # Prune before the restart so the fresh shell starts against a bounded cache
    # and never re-reads a 56MB entry left by the previous one.
    prune_image_cache
    restart_shell
    verify_shell
    printf '\033[1;32m✓\033[0m Updated to %s\n' "$(git log --oneline -1)"
else
    printf '\033[1;32m✓\033[0m Already up to date (%s)\n' "$(git rev-parse --short HEAD)"
fi

# --- 5. Upstream Caelestia check (read-only, never merges) -----------------
# ./update only syncs our fork (origin). New upstream Caelestia releases are
# ported by hand — see fadcaf28 "Port custom fork onto caelestia v2.0.3". This
# step just *reports* if upstream/main has moved past where our fork is based,
# so we know when a manual port is due. It fetches read-only and never fails
# the update (network hiccup, missing remote → silently skipped).
if git remote get-url upstream >/dev/null 2>&1; then
    if git fetch --quiet --tags upstream main 2>/dev/null; then
        # Compare against the latest RELEASE TAG, not upstream/main's tip:
        # ./update --port targets the tag, and main is normally several
        # unreleased commits past it — measuring to main's tip would nag
        # "port due" forever even on a freshly-ported branch.
        tag="$(git describe --tags --abbrev=0 upstream/main 2>/dev/null || true)"
        if [ -n "$tag" ]; then
            if git merge-base --is-ancestor "$tag" HEAD 2>/dev/null; then
                printf '\033[1;32m✓\033[0m Up to date with latest upstream Caelestia release (%s).\n' "$tag"
            else
                behind="$(git rev-list --count "HEAD..$tag" 2>/dev/null || echo '?')"
                printf '\033[1;33m!\033[0m Newer upstream Caelestia release available: %s (%s commit(s) not in your branch).\n' "$tag" "$behind"
                printf '  Run ./update --port to rebase your custom commits onto it.\n'
            fi
        fi
    fi
fi
