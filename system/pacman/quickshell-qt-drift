#!/usr/bin/env bash
# Warn when a library upgrade leaves quickshell or the caelestia plugin linked
# against symbols that are no longer there.
#
# Two independent breakages, same shape and the same blind spot:
#
#   1. quickshell-git is an AUR package built against whatever Qt was installed
#      at build time, and it resolves ~60 Qt_6_PRIVATE_API symbols spanning
#      Qt6Core, Qt6Gui, Qt6Qml, Qt6Quick and Qt6WaylandClient. When a Qt update
#      moves one of them (6.11.2 promoted
#      QUntypedPropertyBinding(QPropertyBindingPrivate*) from Qt_6_PRIVATE_API
#      to Qt_6), qs dies at the dynamic linker with exit 127 on the next start,
#      before a line of QML is parsed.
#
#   2. The fork's native plugin under /usr/lib/qt6/qml/Caelestia is built the
#      same way, against whatever libcava / aubio / qalculate / pipewire /
#      libsensors happened to be installed then. This one is invisible to check
#      1: qs itself links fine and starts, and the failure only lands when QML
#      imports the plugin, as a `Type Audio unavailable` config error and a
#      restart loop. 2026-08-23: libcava 0.10.7 -> 1.0.0 moved libcava.so.0 to
#      .so.1 and cost a login.
#
# Both are LATENT. The running shell already has the old library mapped and
# keeps working, so nothing looks wrong until the next cold start - typically
# the next login, hours or days after the upgrade that caused it, at which
# point systemd restart-loops a process that can never link.
#
# Ground truth is `ldd -r`, not package mtimes: it resolves every relocation
# against what is installed at this instant, which is exactly the thing that
# fails at startup. It therefore cannot false-positive on a `yay -Syu` that
# upgrades a library and rebuilds its dependents in the same transaction.
#
# Scope note: this checks the caelestia plugin's ENTIRE dependency surface, not
# a hand-listed set of packages. The list is ~20 libraries deep and the one that
# actually broke (libcava) was never on any list we would have thought to write
# - which is the whole argument for asking the linker instead. The hook's Path
# trigger is broad for the same reason.
#
# Always exits 0 - a warning must never abort a system upgrade.

set -uo pipefail

STAMP=/var/lib/quickshell-qt-drift
QS_BIN=/usr/bin/quickshell
PLUGIN_DIRS=(/usr/lib/qt6/qml/Caelestia /usr/lib/qt6/qml/M3Shapes)

# Cap the report so a genuinely broken toolchain (every object failing at once)
# cannot bury the rest of the pacman transaction in output.
MAX_OBJECTS=6
MAX_LINES_PER_OBJECT=3

report=""
objects=0

# Append any unresolved relocations for one object to $report.
# Returns 0 if the object is broken, 1 if it is clean. Catches both halves of
# the failure: a DT_NEEDED that no longer exists ("libcava.so.0 => not found")
# and a symbol that survived the soname bump but lost its definition.
probe() {
    local obj="$1" out
    out="$(ldd -r "$obj" 2>&1 | grep -E 'not found|undefined symbol' | head -"$MAX_LINES_PER_OBJECT")"
    [ -n "$out" ] || return 1
    if [ "$objects" -lt "$MAX_OBJECTS" ]; then
        report+="  $obj"$'\n'
        report+="$(printf '%s\n' "$out" | sed 's/^[[:space:]]*/    /')"$'\n'
    fi
    objects=$((objects + 1))
    return 0
}

qs_broken=false
plugin_broken=false

[ -x "$QS_BIN" ] && probe "$QS_BIN" && qs_broken=true

for dir in "${PLUGIN_DIRS[@]}"; do
    [ -d "$dir" ] || continue
    # Process substitution, not a pipe: the loop must run in THIS shell or
    # plugin_broken is set in a subshell and lost.
    while IFS= read -r so; do
        probe "$so" && plugin_broken=true
    done < <(find "$dir" -type f -name '*.so' | sort)
done

if [ -z "$report" ]; then
    rm -f "$STAMP"
    exit 0
fi

[ "$objects" -gt "$MAX_OBJECTS" ] &&
    report+="  ... and $((objects - MAX_OBJECTS)) more object(s)"$'\n'

# The stamp is what ./update --status reads to say "a rebuild is due" long after
# this scrolled past. Best-effort: ldd -r is the authority, so failing to write
# it only costs a less informative status line.
{
    printf 'unresolved symbols against the libraries installed now.\n'
    printf 'detected: %s\n' "$(date -Is)"
    printf '%s' "$report"
} >"$STAMP" 2>/dev/null || true

printf '\033[1;33m==> WARNING:\033[0m unresolved symbols after this upgrade.\n' >&2
printf '    The running shell is fine - it will die at the NEXT restart or login.\n' >&2
printf '%s' "$report" >&2
[ "$qs_broken" = true ] &&
    printf '    Fix quickshell:  yay -S quickshell-git\n' >&2
[ "$plugin_broken" = true ] &&
    printf '    Fix the plugin:  ./update --force-build\n' >&2

exit 0
