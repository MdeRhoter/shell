#!/usr/bin/env bash
# Warn when a library upgrade leaves quickshell or the caelestia plugin linked
# against symbols that are no longer there - and name the package that actually
# needs rebuilding, then ask caelestia-auto-rebuild to do it.
#
# Three breakages, same shape and the same blind spot:
#
#   1. quickshell-git is an AUR package built against whatever Qt was installed
#      at build time, and it resolves ~60 Qt_6_PRIVATE_API symbols spanning
#      Qt6Core, Qt6Gui, Qt6Qml, Qt6Quick and Qt6WaylandClient. When a Qt update
#      moves one of them (6.11.2 promoted
#      QUntypedPropertyBinding(QPropertyBindingPrivate*) from Qt_6_PRIVATE_API
#      to Qt_6), qs dies at the dynamic linker with exit 127 on the next start,
#      before a line of QML is parsed. Qt 6.11.2 -> 6.12.0 (2026-10-16) broke it
#      with every symbol still resolvable, so ldd alone is not enough: we also
#      run `quickshell --private-check-compat`.
#
#   2. The fork's native plugin under /usr/lib/qt6/qml/Caelestia is built the
#      same way, against whatever libcava / aubio / qalculate / pipewire /
#      libsensors happened to be installed then. This one is invisible to check
#      1: qs itself links fine and starts, and the failure only lands when QML
#      imports the plugin, as a `Type Audio unavailable` config error and a
#      restart loop. 2026-08-23: libcava 0.10.7 -> 1.0.0 moved libcava.so.0 to
#      .so.1 and cost a login.
#
#   3. A library the plugin depends on is ITSELF an AUR package that broke.
#      2026-11-21: sndio 1.10 -> 1.11 replaced libsndio.so.7 with .so.9, and the
#      AUR libcava (built 2026-08-15) still wanted .so.7. ldd on the plugin
#      reports that, but rebuilding the plugin fixes nothing - libcava is what
#      needs the rebuild. So for every broken object we find WHICH object in its
#      dependency tree has the missing DT_NEEDED / undefined symbol, and map
#      that to its package.
#
# All are LATENT. The running shell already has the old library mapped and
# keeps working, so nothing looks wrong until the next cold start - typically
# the next login, hours or days after the upgrade that caused it, at which
# point systemd restart-loops a process that can never link.
#
# Ground truth is `ldd -r`, not package mtimes: it resolves every relocation
# against what is installed at this instant, which is exactly the thing that
# fails at startup. It therefore cannot false-positive on a `yay -Syu` that
# upgrades a library and rebuilds its dependents in the same transaction.
#
# Scope note: this checks the caelestia plugin's ENTIRE dependency surface, not
# a hand-listed set of packages. The one that broke was never on any list we
# would have thought to write - which is the whole argument for asking the
# linker instead. The hook's Path trigger is broad for the same reason.
#
# Output, besides the warning:
#   $STAMP    human-readable report, read by ./update --status.
#   $REQUEST  one package per line, foreign (AUR / local) packages only, in
#             build order (libraries before the things linking them). Watched
#             by the user's caelestia-auto-rebuild.path. Rewritten only when
#             its content changes (the .path unit uses PathChanged), removed
#             when everything is clean again.
#
# Always exits 0 - a warning must never abort a system upgrade.

set -uo pipefail

STAMP=/var/lib/quickshell-qt-drift
REQUEST_DIR=/var/lib/caelestia-rebuild
REQUEST=$REQUEST_DIR/request
QS_BIN=/usr/bin/quickshell
PLUGIN_DIRS=(/usr/lib/qt6/qml/Caelestia /usr/lib/qt6/qml/M3Shapes)

# Cap the report so a genuinely broken toolchain (every object failing at once)
# cannot bury the rest of the pacman transaction in output.
MAX_OBJECTS=6
MAX_LINES_PER_OBJECT=3

report=""
objects=0
# Packages to rebuild, in discovery order; "libs" are dependencies of the
# things we check and must be rebuilt first.
declare -a rebuild_libs=() rebuild_top=() repo_culprits=()

contains() {
    local needle="$1" x
    shift
    for x in "$@"; do [ "$x" = "$needle" ] && return 0; done
    return 1
}

# Direct DT_NEEDED sonames of one ELF object.
needed_of() {
    LC_ALL=C readelf -d "$1" 2>/dev/null | sed -n 's/.*(NEEDED).*\[\(.*\)\]/\1/p'
}

# Which objects are actually at fault for $1's unresolved relocations?
# - "undefined symbol: X (path)": ldd names the object that wants X.
# - "libfoo.so.N => not found": the object whose OWN DT_NEEDED lists it; found
#   by checking $1 and every library ldd resolved for it.
culprits_of() {
    local obj="$1" ldd_out missing m lib
    ldd_out="$(ldd -r "$obj" 2>&1)"
    printf '%s\n' "$ldd_out" | sed -n 's/^.*undefined symbol: .*(\(\/[^)]*\))$/\1/p'
    missing="$(printf '%s\n' "$ldd_out" | sed -n 's/^[[:space:]]*\([^[:space:]]*\) => not found$/\1/p' | sort -u)"
    [ -n "$missing" ] || return 0
    while IFS= read -r lib; do
        [ -f "$lib" ] || continue
        for m in $missing; do
            needed_of "$lib" | grep -qxF "$m" && printf '%s\n' "$lib"
        done
    done < <({ printf '%s\n' "$obj"; printf '%s\n' "$ldd_out" | sed -n 's/^.* => \(\/[^ ]*\) (.*/\1/p'; } | sort -u)
}

# Record the package that owns $1 for rebuilding. $2 = lib|top.
blame() {
    local path="$1" kind="$2" pkg
    pkg="$(pacman -Qqo "$path" 2>/dev/null | head -1)"
    [ -n "$pkg" ] || return 0
    # A repo package cannot be fixed by rebuilding it here: that is a partial
    # upgrade or a packaging bug upstream. Report it, do not queue it.
    if ! pacman -Qqm "$pkg" >/dev/null 2>&1; then
        contains "$pkg" "${repo_culprits[@]}" || repo_culprits+=("$pkg")
        return 0
    fi
    if [ "$kind" = lib ]; then
        contains "$pkg" "${rebuild_libs[@]}" || rebuild_libs+=("$pkg")
    else
        contains "$pkg" "${rebuild_top[@]}" || rebuild_top+=("$pkg")
    fi
}

# Append any unresolved relocations for one object to $report and blame the
# objects responsible. Returns 0 if the object is broken, 1 if it is clean.
probe() {
    local obj="$1" out c
    out="$(ldd -r "$obj" 2>&1 | grep -E 'not found|undefined symbol' | head -"$MAX_LINES_PER_OBJECT")"
    [ -n "$out" ] || return 1
    if [ "$objects" -lt "$MAX_OBJECTS" ]; then
        report+="  $obj"$'\n'
        report+="$(printf '%s\n' "$out" | sed 's/^[[:space:]]*/    /')"$'\n'
    fi
    objects=$((objects + 1))
    while IFS= read -r c; do
        [ -n "$c" ] || continue
        if [ "$c" = "$obj" ]; then blame "$c" top; else blame "$c" lib; fi
    done < <(culprits_of "$obj" | sort -u)
    return 0
}

if [ -x "$QS_BIN" ]; then
    if ! probe "$QS_BIN"; then
        # Links fine; still check the private-API compat Qt can break silently.
        if ! "$QS_BIN" --private-check-compat >/dev/null 2>&1; then
            report+="  $QS_BIN"$'\n'"    quickshell --private-check-compat failed (Qt private API changed)"$'\n'
            objects=$((objects + 1))
            blame "$QS_BIN" top
        fi
    fi
fi

for dir in "${PLUGIN_DIRS[@]}"; do
    [ -d "$dir" ] || continue
    # Process substitution, not a pipe: the loop must run in THIS shell or the
    # arrays are filled in a subshell and lost.
    while IFS= read -r so; do
        probe "$so"
    done < <(find "$dir" -type f -name '*.so' | sort)
done

if [ -z "$report" ]; then
    rm -f "$STAMP" "$REQUEST"
    exit 0
fi

[ "$objects" -gt "$MAX_OBJECTS" ] &&
    report+="  ... and $((objects - MAX_OBJECTS)) more object(s)"$'\n'

rebuild=("${rebuild_libs[@]}")
for p in "${rebuild_top[@]}"; do
    contains "$p" "${rebuild[@]}" || rebuild+=("$p")
done

# The stamp is what ./update --status reads to say "a rebuild is due" long after
# this scrolled past. Best-effort: ldd -r is the authority, so failing to write
# it only costs a less informative status line.
{
    printf 'unresolved symbols against the libraries installed now.\n'
    printf 'detected: %s\n' "$(date -Is)"
    printf '%s' "$report"
    [ "${#rebuild[@]}" -gt 0 ] && printf 'rebuild: %s\n' "${rebuild[*]}"
    [ "${#repo_culprits[@]}" -gt 0 ] && printf 'repo packages at fault: %s\n' "${repo_culprits[*]}"
} >"$STAMP" 2>/dev/null || true

# Only rewrite the request when it changes: the watcher uses PathChanged, so an
# identical rewrite would re-trigger a rebuild that already failed.
if [ "${#rebuild[@]}" -gt 0 ]; then
    new="$(printf '%s\n' "${rebuild[@]}")"
    if [ "$(cat "$REQUEST" 2>/dev/null)" != "$new" ]; then
        mkdir -p "$REQUEST_DIR" 2>/dev/null &&
            printf '%s\n' "$new" >"$REQUEST.tmp" 2>/dev/null &&
            mv -f "$REQUEST.tmp" "$REQUEST" 2>/dev/null || true
    fi
else
    rm -f "$REQUEST"
fi

printf '\033[1;33m==> WARNING:\033[0m unresolved symbols after this upgrade.\n' >&2
printf '    The running shell is fine - it will die at the NEXT restart or login.\n' >&2
printf '%s' "$report" >&2
if [ "${#rebuild[@]}" -gt 0 ]; then
    printf '    Needs a rebuild: %s\n' "${rebuild[*]}" >&2
    printf '    caelestia-auto-rebuild will do this in your session (password prompt).\n' >&2
    printf '    By hand: yay -S --rebuild %s\n' "$(printf '%s\n' "${rebuild[@]}" | grep -vx caelestia-shell-fork | tr '\n' ' ')" >&2
    contains caelestia-shell-fork "${rebuild[@]}" &&
        printf '    and for the plugin: ./update --force-build\n' >&2
fi
[ "${#repo_culprits[@]}" -gt 0 ] &&
    printf '    Broken repo package(s), not rebuildable here: %s (partial upgrade? try pacman -Syu)\n' "${repo_culprits[*]}" >&2

exit 0
